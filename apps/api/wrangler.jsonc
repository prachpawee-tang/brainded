{
  // One Worker serves the web app (static export of apps/app) and the API on the same origin,
  // so Better Auth cookies stay first-party. Deployed by .github/workflows/ci.yml (deploy job).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "brain",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Keep in sync with isApiPath() in src/worker.ts.
    "run_worker_first": ["/api/*", "/graphql", "/healthz"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Created once with `wrangler hyperdrive create brain-db` (see docs/deploy.md). Not a secret.
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_BUCKET": "brain-files",
    "AWS_REGION": "ap-southeast-1"
  },
  "observability": { "enabled": true }
}
