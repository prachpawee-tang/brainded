{
  "name": "@brain/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local src/server.ts",
    "codegen": "tsx scripts/export-schema.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.int.test.ts'",
    "test:int": "vitest run int.test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@brain/auth": "workspace:*",
    "@brain/core": "workspace:*",
    "@brain/db": "workspace:*",
    "@brain/graphql": "workspace:*",
    "@brain/module-pets": "workspace:*",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.6",
    "@hono/node-server": "^2.1.5",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@brain/config": "workspace:*"
  }
}
