{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["jest", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "codegen.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
