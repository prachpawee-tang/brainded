# ── API (apps/api) ──────────────────────────────────────────────
# Postgres connection string (Neon free tier in prod, any Postgres locally)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brain
PORT=4000
NODE_ENV=development

# ── App (apps/app) — EXPO_PUBLIC_* is bundled into the client, never put secrets here
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql
