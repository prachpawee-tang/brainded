{
  "name": "@brain/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./pg-core": "./src/pg-core.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.int.test.ts'",
    "test:int": "vitest run int.test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@brain/config": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
